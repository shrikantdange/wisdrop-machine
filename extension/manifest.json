{
  "manifest_version": 3,
  "name": "Wisdrop Studio",
  "version": "1.0.0",
  "description": "Side panel for the Wisdrop machine: run the 4 agents with any AI key, drive GitHub + Modal workflows, review and approve at owner gates.",
  "minimum_chrome_version": "116",
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "action": {"default_title": "Open Wisdrop Studio", "default_icon": {"16": "icons/16.png", "48": "icons/48.png"}},
  "background": {"service_worker": "background.js", "type": "module"},
  "side_panel": {"default_path": "sidepanel.html"},
  "permissions": ["sidePanel", "storage", "scripting", "activeTab", "clipboardWrite"],
  "host_permissions": ["https://api.github.com/*"],
  "optional_host_permissions": [
    "https://api.openai.com/*", "https://openrouter.ai/*", "https://api.groq.com/*",
    "https://api.deepseek.com/*", "https://api.mistral.ai/*", "https://api.together.xyz/*",
    "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*",
    "http://localhost/*", "http://127.0.0.1/*", "https://*/*"
  ],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
