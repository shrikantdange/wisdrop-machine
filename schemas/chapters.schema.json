{"$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Wisdrop chapters.json",
 "type": "object", "required": ["ep", "chapters"],
 "properties": {"ep": {"type": "string"}, "wpm": {"type": "number"},
  "chapters": {"type": "array", "minItems": 1, "items": {"type": "object",
   "required": ["id", "part", "lines", "target_s", "entry", "exit", "handoff"],
   "properties": {"id": {"type": "string", "pattern": "^c[0-9]{2}$"}, "part": {"type": "string"},
    "lines": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
    "target_s": {"type": "number", "minimum": 30, "maximum": 150}, "title": {"type": "string"},
    "purpose": {"type": "string"}, "peak": {"type": "object"},
    "entry": {"$ref": "#/$defs/state"}, "exit": {"$ref": "#/$defs/state"},
    "handoff": {"type": "string"}, "risks": {"type": "array", "items": {"type": "string"}}}}}},
 "$defs": {"state": {"type": "object", "required": ["board", "music"],
  "properties": {"board": {"enum": ["navy", "offwhite", "sky", "charcoal"]}, "accent": {"type": "string"},
   "counter": {"type": ["object", "null"]}, "music": {"type": "string"}, "loop": {"type": ["string", "null"]}}}}}
